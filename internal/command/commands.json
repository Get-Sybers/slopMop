{
  "usage": "-inputdir <folder> VERB [section ...] [options]",
  "options": [
    {"name": "inputdir", "hint": "<folder>", "summary": "the folder of scripts and outputs to read"},
    {"name": "intelfile", "hint": "<file>", "summary": "a watchlist, JSON or STIX 2.1, to attribute the indicators to"},
    {"name": "outdir", "hint": "<folder>", "summary": "where the output is saved; slopmop-<name> in the current directory when not given"},
    {"name": "cores", "hint": "<percent>", "summary": "how much of the processors of this machine the run may use, 1 to 100; all of them when not given"},
    {"name": "memory", "hint": "<percent>", "summary": "how much of the memory of this machine the run tries to stay within, 1 to 100; 75 when not given"},
    {"name": "progress", "hint": "shown|hidden", "summary": "whether the run says what it is doing as it goes, on the error stream; shown on a terminal when not given"},
    {"name": "start", "hint": "<time>", "summary": "reads only the files of this time or later, such as 2026-10-22 or 2026-10-22T09:30:00Z; alone, it looks forward from this time"},
    {"name": "stop", "hint": "<time>", "summary": "reads only the files of this time or earlier, a day alone counted to its end; alone, it looks back from this time"}
  ],
  "verbs": [
    {
      "name": "report",
      "summary": "reads the folder and everything below it, runs nothing, prints the report and saves it",
      "requires": ["inputdir"],
      "takes": ["intelfile", "outdir", "cores", "memory", "progress", "start", "stop"],
      "sections": [
        {"name": "summary", "title": "Summary", "summary": "the counts"},
        {"name": "tactics", "title": "Tactics", "summary": "each tactic the files show, most severe first, with its ATT&CK and ATLAS identifiers and the intents that show it", "note": "tactic, identifiers, files"},
        {"name": "timeline", "title": "Timeline", "summary": "what was done, in order of time: a block for each ARTEX intent i<number>, or for each period where no file names an intent, with each ATT&CK technique its files show and the tactic and ATLAS technique that follow from it", "note": "a block for each intent, from the first of its files to be created until the last, or for each period of files that show the same tactics; a row is an ATT&CK technique, then its tactic and its ATLAS technique, or the tools of a tactic that no technique is named for"},
        {"name": "findings", "title": "Findings", "summary": "each activity, most severe first, with the lines that show it"},
        {"name": "targeted", "title": "Targeted", "summary": "what the scripts name and what activities acted on", "note": "hardcoded values: prior means no earlier output holds it, discovered means one does; subjects: each entity an activity acted on"},
        {"name": "exposure", "title": "Exposure", "summary": "the passwords, usernames, emails, tenants, SSH keys, API keys, applications, cloud resources, devices and addresses the files hold, and what is of Microsoft 365 and of Google Cloud", "note": "collected: first seen in an output; used: first seen in a script; a token or a value in base64 is written decoded, and the saved exposure file holds it as it stands"},
        {"name": "impact", "title": "Impact", "summary": "what the findings mean, with the exposed accounts and credentials each concerns"},
        {"name": "remediation", "title": "Remediation", "summary": "what to do about them, most urgent first, with the exposed accounts and credentials each concerns", "note": "most urgent first"},
        {"name": "mitigation", "title": "Mitigation", "summary": "what MITRE ATT&CK and ATLAS say prevents the techniques found, with the exposed accounts and credentials each concerns", "note": "MITRE ATT&CK and ATLAS, for the techniques found"}
      ],
      "hints": [
        "one section: slopmop -inputdir <folder> report impact"
      ],
      "saved": {
        "prefix": "slopmop-",
        "readouts": [
          {"format": "text", "file": "report.txt"},
          {"format": "markdown", "file": "report.md"},
          {"format": "html", "file": "report.html"}
        ],
        "tables": [
          {"class": "file", "format": "csv", "file": "files.csv"},
          {"class": "trace", "format": "json", "file": "trace.json"},
          {"class": "intent", "format": "csv", "file": "intents.csv"},
          {"class": "finding", "format": "csv", "file": "findings.csv"},
          {"class": "finding", "format": "json", "file": "findings.json"},
          {"class": "targeted", "format": "json", "file": "targeted.json"},
          {"class": "exposure", "format": "csv", "file": "exposure.csv"},
          {"class": "report", "format": "json", "file": "report.json"}
        ]
      }
    }
  ],
  "classes": [
    {
      "name": "file",
      "columns": [
        {"header": "NAME", "key": "name"},
        {"header": "PATH", "key": "path", "wide": true},
        {"header": "ROLE", "key": "role"},
        {"header": "SIZE", "key": "size"},
        {"header": "LINES", "key": "lines"},
        {"header": "MODIFIED", "key": "modified"},
        {"header": "CREATED", "key": "created"},
        {"header": "SHA256", "key": "sha256", "wide": true},
        {"header": "NAME TIME", "key": "name_time", "wide": true},
        {"header": "NOTE", "key": "note", "wide": true}
      ]
    },
    {
      "name": "trace",
      "columns": [
        {"header": "STEP", "key": "step"},
        {"header": "NAME", "key": "name"},
        {"header": "ROLE", "key": "role"},
        {"header": "TIME", "key": "time"},
        {"header": "INTENT", "key": "intent", "wide": true},
        {"header": "TOOLS", "key": "tools"},
        {"header": "TACTICS", "key": "tactics"},
        {"header": "TRANSFORMS", "key": "transforms"},
        {"header": "ACTIVITIES", "key": "activities", "wide": true},
        {"header": "OUTPUTS", "key": "outputs", "wide": true},
        {"header": "INDICATORS", "key": "indicators", "wide": true},
        {"header": "INTEL", "key": "intel", "wide": true},
        {"header": "NOTE", "key": "note", "wide": true}
      ]
    },
    {
      "name": "finding",
      "columns": [
        {"header": "FINDING", "key": "finding"},
        {"header": "SEVERITY", "key": "severity"},
        {"header": "TACTIC", "key": "tactic"},
        {"header": "INDICATOR", "key": "indicator"},
        {"header": "FILES", "key": "files"},
        {"header": "ATTRIBUTION", "key": "attribution"},
        {"header": "FIRST", "key": "first"},
        {"header": "LAST", "key": "last"},
        {"header": "ATTACK", "key": "attack", "wide": true},
        {"header": "ATLAS", "key": "atlas", "wide": true},
        {"header": "EVIDENCE", "key": "evidence", "wide": true},
        {"header": "WHAT", "key": "what", "wide": true},
        {"header": "TARGETS", "key": "targets", "wide": true},
        {"header": "IP", "key": "ip", "wide": true},
        {"header": "HOST", "key": "host", "wide": true},
        {"header": "PORT", "key": "port", "wide": true},
        {"header": "URL", "key": "url", "wide": true},
        {"header": "SHARE", "key": "share", "wide": true},
        {"header": "ACCOUNT", "key": "account", "wide": true},
        {"header": "TENANT", "key": "tenant", "wide": true},
        {"header": "APPLICATION", "key": "application", "wide": true},
        {"header": "ROLE", "key": "role", "wide": true},
        {"header": "RESOURCE", "key": "resource", "wide": true},
        {"header": "VAULT", "key": "vault", "wide": true},
        {"header": "SECRET", "key": "secret", "wide": true},
        {"header": "KEY", "key": "key", "wide": true},
        {"header": "TASK", "key": "task", "wide": true},
        {"header": "SERVICE", "key": "service", "wide": true},
        {"header": "PROCESS", "key": "process", "wide": true},
        {"header": "COMMAND", "key": "command", "wide": true},
        {"header": "FILE", "key": "file", "wide": true},
        {"header": "ARCHIVE", "key": "archive", "wide": true},
        {"header": "LOG", "key": "log", "wide": true},
        {"header": "REGISTRY", "key": "registry", "wide": true}
      ],
      "entities": [
        {"column": "ip", "kinds": ["ip"], "indicators": ["IPv4"]},
        {"column": "host", "labels": ["host"], "kinds": ["device"], "indicators": ["Domain"]},
        {"column": "port", "labels": ["port"]},
        {"column": "url", "labels": ["url"], "indicators": ["URL", "GraphEndpoint", "AzureManagementEndpoint", "EntraLoginEndpoint", "KeyVaultEndpoint"]},
        {"column": "share", "patterns": [
          {"pattern": "(?m:^|[^\\w:\\\\])\\\\\\\\(?P<host>(?:[A-Za-z0-9][A-Za-z0-9._-]*|\\$\\{?[A-Za-z_]\\w*\\}?|%\\w+%))\\\\(?P<share>(?:[A-Za-z0-9_$-]+(?:\\.[A-Za-z0-9_$-]+)*|%\\w+%))", "value": "\\\\${host}\\${share}"},
          {"pattern": "(?m:^|[^\\w:\\\\])\\\\\\\\\\\\\\\\(?P<host>(?:[A-Za-z0-9][A-Za-z0-9._-]*|\\$\\{?[A-Za-z_]\\w*\\}?|%\\w+%))\\\\\\\\(?P<share>(?:[A-Za-z0-9_$-]+(?:\\.[A-Za-z0-9_$-]+)*|%\\w+%))", "value": "\\\\${host}\\${share}"},
          {"pattern": "(?i)\\b(?:smbclient|smbget|smbcacls|smbtar|mount(?:\\.cifs)?)\\b[^\\n|;&]*?[\\s'\"=]//(?P<host>(?:[A-Za-z0-9][A-Za-z0-9._-]*|\\$\\{?[A-Za-z_]\\w*\\}?|%\\w+%))/(?P<share>(?:[A-Za-z0-9_$-]+(?:\\.[A-Za-z0-9_$-]+)*|%\\w+%))", "value": "\\\\${host}\\${share}"},
          {"pattern": "(?i)\\bsmb://(?:[^/@\\s]+@)?(?P<host>(?:[A-Za-z0-9][A-Za-z0-9._-]*|\\$\\{?[A-Za-z_]\\w*\\}?|%\\w+%))/(?P<share>(?:[A-Za-z0-9_$-]+(?:\\.[A-Za-z0-9_$-]+)*|%\\w+%))", "value": "\\\\${host}\\${share}"}
        ]},
        {"column": "account", "labels": ["account", "principal", "mailbox"], "kinds": ["username", "email"], "indicators": ["Email"]},
        {"column": "tenant", "labels": ["tenant"], "kinds": ["tenant"]},
        {"column": "application", "labels": ["application", "client"], "kinds": ["application"]},
        {"column": "role", "labels": ["role", "permission"]},
        {"column": "resource", "labels": ["resource", "site", "subscription", "namespace", "chat"], "kinds": ["resource"]},
        {"column": "vault", "labels": ["vault"]},
        {"column": "secret", "labels": ["secret"]},
        {"column": "key", "labels": ["key"]},
        {"column": "task", "labels": ["task", "timer"]},
        {"column": "service", "labels": ["service", "unit"]},
        {"column": "process", "labels": ["process", "program", "binary"]},
        {"column": "command", "labels": ["runs", "command", "call", "function", "adds", "rule", "setting"]},
        {"column": "file", "labels": ["file", "saved as", "output", "job file", "library", "module", "socket", "mount", "searched"]},
        {"column": "archive", "labels": ["archive"]},
        {"column": "log", "labels": ["log"]},
        {"column": "registry", "labels": ["hive", "value"]}
      ]
    },
    {
      "name": "targeted",
      "columns": [
        {"header": "KIND", "key": "kind"},
        {"header": "VALUE", "key": "value"},
        {"header": "ORIGIN", "key": "origin"},
