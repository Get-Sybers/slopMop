    "files": null
  },
  {
    "item": "Privileged access obtained",
    "section": "impact",
    "value": "high",
    "detail": "A principal was given a privileged role or permission. Treat what it governs as under attacker control until reviewed.",
    "basis": "GlobalAdministratorAssignment, AppRoleAssignment",
    "files": "20261015_091000_step03_escalate.ps1, agent_20261015_093500.jsonl"
  },
  {
    "item": "Credentials exposed",
    "section": "impact",
    "value": "high",
    "detail": "Secrets, keys, certificates or stored passwords were read. Treat them as known to the attacker. Affected: corpvault.vault.azure.net, finvault.vault.azure.net.",
    "basis": "KeyVaultSecretRead, KeyVaultKeyUnwrap",
    "files": "20261015_093000_step05_vault.sh, agent_20261015_093500.jsonl"
  },
  {
    "item": "Persistence established",
    "section": "impact",
    "value": "high",
    "detail": "A way back in was created: a credential, a run key, a task or a service. Access survives a password reset.",
    "basis": "AppCredentialAddition",
    "files": "20261015_091000_step03_escalate.ps1"
  },
  {
    "item": "Valid identity used",
    "section": "impact",
    "value": "high",
    "detail": "The attacker signed in as an identity that exists. Sign-in controls did not stop it.",
    "basis": "TokenRequest",
    "files": "20261015_090000_step01_token.sh"
  },
  {
    "item": "Data collected",
    "section": "impact",
    "value": "high",
    "detail": "Mail, chat or documents were read in bulk. Treat their content as disclosed. Affected: alice@corp.example, bob@corp.example.",
    "basis": "MailboxAccess, TeamsMessageAccess, SharePointEnumeration",
    "files": "20261015_092000_step04_collect.py"
  },
  {
    "item": "Environment mapped",
    "section": "impact",
    "value": "low",
    "detail": "Identities, resources or configuration were listed. Later steps were probably aimed with the result.",
    "basis": "GraphDirectoryEnumeration, AzureResourceEnumeration, KeyVaultKeyEnumeration, Discovery tools",
    "files": "20261015_090000_step01_token.sh, 20261015_090500_step02_recon.ps1, 20261015_093000_step05_vault.sh, agent_20261015_093500.jsonl"
  },
  {
    "item": "Revoke sessions and reset identities",
    "section": "remediation",
    "value": "high",
    "detail": "Revoke the sessions and tokens of every identity in the evidence and reset its credentials.",
    "basis": "TokenRequest",
    "files": "20261015_090000_step01_token.sh"
  },
  {
    "item": "Remove added credentials",
    "section": "remediation",
    "value": "high",
    "detail": "Remove every password and key added to an application or service principal, then review all credentials added since the first step.",
    "basis": "AppCredentialAddition",
    "files": "20261015_091000_step03_escalate.ps1"
  },
  {
    "item": "Remove role and permission grants",
    "section": "remediation",
    "value": "high",
    "detail": "Remove the role assignments and application permissions that were granted, then review every privileged member and consent.",
    "basis": "GlobalAdministratorAssignment, AppRoleAssignment",
    "files": "20261015_091000_step03_escalate.ps1, agent_20261015_093500.jsonl"
  },
  {
    "item": "Rotate what was read",
    "section": "remediation",
    "value": "high",
    "detail": "Rotate every secret, key and certificate that was read, and reset the accounts of any host whose credentials were dumped.",
    "basis": "KeyVaultSecretRead, KeyVaultKeyUnwrap",
    "files": "20261015_093000_step05_vault.sh, agent_20261015_093500.jsonl"
  },
  {
    "item": "Scope the data taken",
    "section": "remediation",
    "value": "high",
    "detail": "Establish from audit logs which mailboxes, chats, sites and files were read or sent out, and assess that data as breached.",
    "basis": "MailboxAccess, TeamsMessageAccess, SharePointEnumeration",
    "files": "20261015_092000_step04_collect.py"
  },
  {
    "item": "Follow what was enumerated",
    "section": "remediation",
    "value": "low",
    "detail": "Use what was listed to predict targets: check those identities, vaults and hosts for later activity.",
    "basis": "GraphDirectoryEnumeration, AzureResourceEnumeration, KeyVaultKeyEnumeration, Discovery tools",
    "files": "20261015_090000_step01_token.sh, 20261015_090500_step02_recon.ps1, 20261015_093000_step05_vault.sh, agent_20261015_093500.jsonl"
  },
  {
    "item": "Restrict application credentials and consent",
    "section": "mitigation",
    "value": "medium",
    "detail": "Limit who may add a credential or grant a permission to an application, and alert when either happens.",
    "basis": "AppCredentialAddition, AppRoleAssignment, TokenRequest",
    "files": "20261015_090000_step01_token.sh, 20261015_091000_step03_escalate.ps1, agent_20261015_093500.jsonl"
  },
  {
    "item": "Guard privileged roles",
    "section": "mitigation",
    "value": "medium",
    "detail": "Require approval and raise an alert for every privileged role assignment, and keep standing membership small.",
    "basis": "GlobalAdministratorAssignment",
    "files": "20261015_091000_step03_escalate.ps1"
  },
  {
    "item": "Harden Key Vault access",
    "section": "mitigation",
    "value": "medium",
    "detail": "Give each identity the least vault access it needs, close vaults to public networks, and alert on bulk reads.",
    "basis": "KeyVaultSecretRead, KeyVaultKeyUnwrap, KeyVaultKeyEnumeration, AzureResourceEnumeration",
    "files": "20261015_093000_step05_vault.sh, agent_20261015_093500.jsonl"
  },
  {
    "item": "Watch application access to mail and files",
    "section": "mitigation",
    "value": "low",
    "detail": "Alert on an application that is granted mail or file permissions, and on one that reads them in volume.",
    "basis": "MailboxAccess, TeamsMessageAccess, SharePointEnumeration, GraphDirectoryEnumeration",
    "files": "20261015_090500_step02_recon.ps1, 20261015_092000_step04_collect.py"
  }
]
