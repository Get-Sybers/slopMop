  {
    "item": "Credentials exposed",
    "section": "impact",
    "value": "high",
    "detail": "Secrets, keys, certificates or stored passwords were read. Treat them as known to the attacker.",
    "basis": "CertificateExport, CredentialAccess tools",
    "files": "20250301_101800_step02_enum.sh, 20250301_102300_step03_adsync.sh, 20250301_103200_step05_certs.sh, 20250301_104000_step06_auth.sh, 20250301_104500_step07_exfil.sh"
  },
  {
    "item": "Data may have left the environment",
    "section": "impact",
    "value": "high",
    "detail": "A transfer out was run. Confirm what was sent and where.",
    "basis": "FileUpload",
    "files": "20250301_104500_step07_exfil.sh"
  },
  {
    "item": "Environment mapped",
    "section": "impact",
    "value": "low",
    "detail": "Identities, resources or configuration were listed. Later steps were probably aimed with the result.",
    "basis": "Discovery tools",
    "files": "20250301_101500_step01_recon.sh, 20250301_101800_step02_enum.sh"
  },
  {
    "item": "Rotate what was read",
    "section": "remediation",
    "value": "high",
    "detail": "Rotate every secret, key and certificate that was read, and reset the accounts of any host whose credentials were dumped.",
    "basis": "CertificateExport, CredentialAccess tools",
    "files": "20250301_101800_step02_enum.sh, 20250301_102300_step03_adsync.sh, 20250301_103200_step05_certs.sh, 20250301_104000_step06_auth.sh, 20250301_104500_step07_exfil.sh"
  },
  {
    "item": "Block and hunt the infrastructure",
    "section": "remediation",
    "value": "high",
    "detail": "Block the addresses and domains in the findings, and search proxy, DNS and firewall logs for other hosts that reached them.",
    "basis": "FileUpload",
    "files": "20250301_104500_step07_exfil.sh"
  },
  {
    "item": "Scope the data taken",
    "section": "remediation",
    "value": "high",
    "detail": "Establish from audit logs which mailboxes, chats, sites and files were read or sent out, and assess that data as breached.",
    "basis": "FileUpload",
    "files": "20250301_104500_step07_exfil.sh"
  },
  {
    "item": "Follow what was enumerated",
    "section": "remediation",
    "value": "low",
    "detail": "Use what was listed to predict targets: check those identities, vaults and hosts for later activity.",
    "basis": "Discovery tools",
    "files": "20250301_101500_step01_recon.sh, 20250301_101800_step02_enum.sh"
  },
  {
    "item": "Constrain living-off-the-land binaries",
    "section": "mitigation",
    "value": "medium",
    "detail": "Use application control to stop system binaries that have no need to from fetching files or running code.",
    "basis": "FileUpload, CertificateExport",
    "files": "20250301_104500_step07_exfil.sh"
  },
  {
    "item": "Protect credentials on hosts",
    "section": "mitigation",
    "value": "medium",
    "detail": "Turn on protection for the local security authority and its credential store, and restrict who may debug processes.",
    "basis": "CertificateExport, CredentialAccess tools",
    "files": "20250301_101800_step02_enum.sh, 20250301_102300_step03_adsync.sh, 20250301_103200_step05_certs.sh, 20250301_104000_step06_auth.sh, 20250301_104500_step07_exfil.sh"
  },
  {
    "item": "Filter outbound traffic",
    "section": "mitigation",
    "value": "medium",
    "detail": "Deny outbound connections from servers by default and allow them by destination.",
    "basis": "FileUpload",
    "files": "20250301_104500_step07_exfil.sh"
  }
]
