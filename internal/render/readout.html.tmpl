<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
<title>{{.Title}}</title>
<style>
:root { --bg: #ffffff; --fg: #1b1f24; --soft: #5b6470; --line: #d8dde3; --panel: #f5f7f9;
  --high: #b3261e; --medium: #9a6700; --low: #5b6470; --clear: #1a7f37; }
@media (prefers-color-scheme: dark) {
  :root { --bg: #0f1317; --fg: #e4e8ec; --soft: #9aa4af; --line: #2b333b; --panel: #171c22;
    --high: #ff7b72; --medium: #e3b341; --low: #9aa4af; --clear: #56d364; }
}
* { box-sizing: border-box; }
body { margin: 0; padding: 24px 16px 48px; background: var(--bg); color: var(--fg);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
main, header, nav, footer { max-width: 1100px; margin: 0 auto; }
h1 { font-size: 22px; margin: 0 0 8px; overflow-wrap: anywhere; white-space: pre-wrap; }
h2 { font-size: 18px; margin: 36px 0 4px; padding-top: 12px; border-top: 1px solid var(--line); }
h3 { font-size: 15px; margin: 20px 0 6px; color: var(--soft); }
.banner { font-weight: 600; margin: 0 0 6px; }
.legend, .note, .none, footer { color: var(--soft); }
.legend { white-space: pre-wrap; }
.note { margin: 0 0 8px; font-size: 13px; }
nav { margin-top: 14px; font-size: 14px; }
nav a { color: inherit; margin-right: 14px; white-space: nowrap; }
.dot { color: var(--soft); }
.high { color: var(--high); } .medium { color: var(--medium); }
.low { color: var(--low); } .clear { color: var(--clear); }
.wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; min-width: 620px; margin: 4px 0 8px; }
th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .04em;
  color: var(--soft); border-bottom: 1px solid var(--line); padding: 4px 12px 4px 0; }
td { vertical-align: top; padding: 5px 12px 5px 0; overflow-wrap: anywhere; }
tr.entry td { border-top: 1px solid var(--line); }
td.mark { white-space: nowrap; font-weight: 600; width: 1%; }
td.cell { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; font-size: 13px; min-width: 11ch; }
tr.detail td { padding-top: 0; }
.under { margin: 0 0 6px; padding: 8px 10px; background: var(--panel); border-radius: 6px; }
.under p { margin: 0 0 6px; }
.pair { display: grid; grid-template-columns: 76px minmax(0, 1fr); column-gap: 8px; margin-bottom: 3px; }
.label { color: var(--soft); font-size: 13px; }
.value { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; font-size: 13px;
  overflow-wrap: anywhere; }
.blocks { list-style: none; margin: 10px 0 8px 5px; padding: 0 0 0 20px; border-left: 2px solid var(--line); }
.block { position: relative; margin: 0 0 12px; padding: 8px 12px; background: var(--panel); border-radius: 6px; }
.dot { position: absolute; left: -27px; top: 13px; width: 12px; height: 12px; border-radius: 50%;
  background: currentColor; border: 2px solid var(--bg); }
.head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; }
.head .mark { font-weight: 600; }
.name { font-weight: 600; font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; overflow-wrap: anywhere; }
.rest { color: var(--soft); font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; font-size: 13px;
  overflow-wrap: anywhere; }
.items { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 2px 14px; margin-top: 6px;
  font-size: 13px; }
.id { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; }
.items .value { font-family: inherit; }
.plain { grid-column: 1 / -1; color: var(--soft); }
footer { margin-top: 40px; font-size: 13px; border-top: 1px solid var(--line); padding-top: 10px; }
footer code { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; }
@media print { nav { display: none; } body { padding: 0; } table { min-width: 0; } }
</style>
</head>
<body>
<header>
<h1>{{.Title}}</h1>
{{- if .Banner}}
<p class="banner {{.BannerLevel}}">{{.Banner}}</p>
{{- end}}
{{- if .Legend}}
<p class="legend">{{.Legend}}</p>
{{- end}}
</header>
<nav>
{{- range .Sections}}
<a href="#{{.ID}}">{{.Title}}</a>
{{- end}}
</nav>
<main>
{{- range .Sections}}
<section id="{{.ID}}">
<h2>{{.Title}}</h2>
{{- if .Note}}
<p class="note">{{.Note}}</p>
{{- end}}
{{- if .Empty}}
<p class="none">none</p>
{{- end}}
{{- range .Groups}}
{{- if .Title}}
<h3>{{.Title}}</h3>
{{- end}}
{{- if .Blocks}}
<ol class="blocks">
{{- range .Rows}}
<li class="block"><span class="dot {{.Level}}"></span>
<div class="head">{{if .Marked}}<span class="mark {{.Level}}">{{.Mark}}</span>{{end}}{{range $i, $c := .Cells}}<span class="{{if $i}}rest{{else}}name{{end}}">{{$c}}</span>{{end}}</div>
{{- if .Detail}}
<div class="items">
{{- range .Detail}}
{{- if .Labelled}}
<span class="id">{{.Label}}</span><span class="value">{{.Text}}</span>
{{- else}}
<span class="plain">{{.Text}}</span>
{{- end}}
{{- end}}
</div>
{{- end}}
</li>
{{- end}}
</ol>
{{- else}}
<div class="wrap">
<table>
{{- if .Columns}}
<thead><tr>{{if .Marked}}<th></th>{{end}}{{range .Columns}}<th>{{.}}</th>{{end}}</tr></thead>
{{- end}}
<tbody>
{{- range .Rows}}
<tr class="entry">{{if .Marked}}<td class="mark {{.Level}}">{{.Mark}}</td>{{end}}{{range .Cells}}<td class="cell">{{.}}</td>{{end}}</tr>
{{- if .Detail}}
<tr class="detail"><td colspan="{{.Span}}"><div class="under">
{{- range .Detail}}
{{- if .Labelled}}
<div class="pair"><span class="label">{{.Label}}</span><span class="value">{{.Text}}</span></div>
{{- else}}
<p>{{.Text}}</p>
{{- end}}
{{- end}}
</div></td></tr>
{{- end}}
{{- end}}
</tbody>
</table>
</div>
{{- end}}
{{- end}}
</section>
{{- end}}
</main>
{{- if .Hints}}
<footer>
{{- range .Hints}}
<div><code>{{.}}</code></div>
{{- end}}
</footer>
{{- end}}
</body>
</html>
