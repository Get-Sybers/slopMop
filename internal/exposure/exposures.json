  "kinds": [
    {
      "name": "password",
      "title": "Passwords and secrets",
      "severity": "high",
      "secret": true,
      "columns": ["what", "seen", "value", "found in"],
      "suffixes": [
        {"suffix": "password", "form": "password"},
        {"suffix": "passwd", "form": "password"},
        {"suffix": "pwd", "form": "password"},
        {"suffix": "pass", "form": "password"},
        {"suffix": "secret", "form": "secret"},
        {"suffix": "credential", "form": "secret"},
        {"suffix": "token", "form": "token"},
        {"suffix": "privatekey", "form": "key"},
        {"suffix": "privatekeydata", "form": "key"},
        {"suffix": "nthash", "form": "hash"},
        {"suffix": "ntlmhash", "form": "hash"}
      ],
      "except": ["nopasswd", "bypass", "compass"],
      "indicators": [{"type": "JWT", "form": "token"}, {"type": "PrivateKey", "form": "key", "unless": "(?:OPENSSH|RSA|DSA|EC) PRIVATE KEY"}],
      "valid": "^\\S.{2,}$",
      "reject": "(?i)^(?:[$%<{(\\[].*|[^A-Za-z0-9]+|x+|null|none|nil|true|false|yes|no|redacted|bearer|basic|\\d{1,5})$",
      "patterns": [
        {"form": "hash", "needs": [":::"], "pattern": "(?m)^(?P<account>[^:\\s]+):\\d+:[0-9a-fA-F]{32}:(?P<value>[0-9a-fA-F]{32}):::"},
        {"form": "hash", "needs": [":$"], "pattern": "(?m)^(?P<account>[a-z_][a-z0-9_-]*\\$?):(?P<value>\\$(?:1|2[abxy]?|5|6|y|argon2\\w*)\\$[^:\\s]+):"},
        {"form": "hash", "needs": ["hash for"], "pattern": "(?i)hash for '?(?P<account>[^':\\s]+)'?:\\s*(?P<value>[0-9a-f]{32}:[0-9a-f]{32})"},
        {"form": "hash", "needs": ["$krb5"], "pattern": "(?P<value>\\$krb5(?:tgs|asrep)\\$\\S{20,})"},
        {"form": "hash", "needs": ["-hashes"], "pattern": "-hashes\\s+['\\\"]?(?P<value>[0-9a-fA-F]{0,32}:[0-9a-fA-F]{32})\\b"},
        {"form": "hash", "needs": [" -h "], "pattern": "\\s-u\\s+['\\\"]?(?P<account>[^\\s'\\\"]+)['\\\"]?\\s+-H\\s+['\\\"]?(?P<value>[0-9a-fA-F]{32}(?::[0-9a-fA-F]{32})?)\\b"},
        {"form": "password", "needs": ["[+]"], "pattern": "\\[\\+\\]\\s+[\\w.-]+\\\\(?P<account>[^\\s:\\\\]+):(?P<value>\\S+)"},
        {"form": "password", "needs": [" -p "], "pattern": "\\s-u\\s+(?P<account>\\\"[^\\\"]+\\\"|'[^']+'|\\S+)\\s+-p\\s+(?P<value>\\\"[^\\\"]+\\\"|'[^']+'|\\S+)"},
        {"form": "password", "needs": ["--password"], "pattern": "--password[= ]\\s*(?P<value>\\\"[^\\\"]+\\\"|'[^']+'|\\S+)"},
        {"form": "password", "needs": ["exportpfx"], "alone": true, "pattern": "(?i)-exportpfx\\s+-p\\s+(?P<value>\"[^\"]+\"|'[^']+'|\\S+)"},
        {"form": "password", "needs": ["sshpass"], "pattern": "\\bsshpass\\s+-p\\s+(?P<value>\\\"[^\\\"]+\\\"|'[^']+'|\\S+)"},
        {"form": "password", "needs": ["://"], "pattern": "://(?P<account>[^:/\\s@\\\"']+):(?P<value>[^@/\\s\\\"']+)@(?P<host>[\\w.-]+)"},
        {"form": "password", "needs": ["/user:"], "pattern": "(?i)/user:(?:[\\w.-]+\\\\)?(?P<account>\\S+)\\s+(?P<value>[^/\\s]\\S*)"},
        {"form": "password", "needs": ["asplaintext"], "pattern": "(?i)ConvertTo-SecureString\\s+(?:-String\\s+)?[\\\"'](?P<value>[^\\\"']+)[\\\"']\\s+-AsPlainText"},
        {"form": "token", "needs": ["bearer"], "pattern": "(?i)\\bAuthorization:\\s*Bearer\\s+(?P<value>[A-Za-z0-9._~+/-]{16,}=*)"},
        {"form": "basic", "needs": ["basic "], "pattern": "(?i)\\bAuthorization:\\s*Basic\\s+(?P<value>[A-Za-z0-9+/]{8,}={0,2})"},
        {"form": "password", "needs": ["curl"], "pattern": "(?:\\s-u|\\s--user)[= ]\\s*[\"']?(?P<account>[^\\s:\"']+):(?P<value>[^\\s\"']+)"},
        {"form": "password", "needs": ["smbclient", "rpcclient", "smbget", "net rpc", "pth-"], "pattern": "\\s-U\\s+[\"']?(?P<account>[^\\s%\"']+)%(?P<value>[^\\s\"']+)"},
        {"form": "password", "needs": ["impacket", ".py ", "secretsdump", "psexec", "wmiexec", "smbexec", "atexec", "dcomexec", "getnpusers", "getuserspns", "gettgt", "getst", "lookupsid", "mssqlclient", "smbclient", "rpcclient", "ticketer", "addcomputer", "ntlmrelayx", "samrdump", "findelegation", "getadusers", "dpapi", "bloodyad", "certipy", "evil-winrm"], "unless": "@sha256:|://", "pattern": "(?:^|\\s)[\"']?[A-Za-z0-9.-]+/(?P<account>[A-Za-z0-9._$-]{2,64}):(?P<value>[^@\\s\"']+)(?:@(?P<host>[\\w.-]+))?"},
        {"form": "password", "needs": ["/add"], "pattern": "(?i)\\bnet1?(?:\\.exe)?\\s+user\\s+(?P<account>[^\\s/\"]+)\\s+(?P<value>[^\\s/*]\\S*)\\s+/add"},
        {"form": "password", "needs": ["chpasswd"], "pattern": "[\"'](?P<account>[a-z_][a-z0-9_-]*):(?P<value>[^\"'\\s]+)[\"']\\s*\\|\\s*(?:sudo\\s+)?chpasswd"},
        {"form": "password", "needs": ["/p:"], "pattern": "(?i)\\s/p:(?P<value>\"[^\"]+\"|'[^']+'|\\S+)"},
        {"form": "password", "needs": ["schtasks", "wmic", "psexec"], "pattern": "(?i)\\s/r?p\\s+(?P<value>\"[^\"]+\"|[^\\s/*]\\S*)"},
        {"form": "password", "needs": [" -pw "], "pattern": "\\s-pw\\s+(?P<value>\"[^\"]+\"|'[^']+'|\\S+)"},
        {"form": "password", "needs": ["ldapsearch", "ldapmodify", "ldapadd", "ldapwhoami", "ldapdelete", "ldappasswd"], "pattern": "\\s-D\\s+(?P<account>\"[^\"]+\"|'[^']+'|\\S+)[^\\n|;]*?\\s-w\\s+(?P<value>\"[^\"]+\"|'[^']+'|\\S+)"},
        {"form": "password", "needs": ["ldapsearch", "ldapmodify", "ldapadd", "ldapwhoami", "ldapdelete", "ldappasswd"], "pattern": "\\s-w\\s+(?P<value>\"[^\"]+\"|'[^']+'|\\S+)[^\\n|;]*?\\s-D\\s+(?P<account>\"[^\"]+\"|'[^']+'|\\S+)"},
        {"form": "password", "needs": ["mysql", "mariadb"], "pattern": "\\s-u\\s*(?P<account>[^\\s-]\\S*)\\s+(?:\\S+\\s+)*?-p(?P<value>[^\\s-]\\S+)"},
        {"form": "password", "needs": ["-password ", "-passwd ", "-pwd "], "pattern": "(?i)\\s-(?:Password|Passwd|Pwd)\\s+(?P<value>\"[^\"$]+\"|'[^'$]+')"}
      ]
    },
    {
      "name": "username",
      "title": "Usernames",
      "severity": "medium",
      "account": true,
      "keys": [
        "user", "username", "login", "loginname", "logname", "account", "accountname", "samaccountname",
