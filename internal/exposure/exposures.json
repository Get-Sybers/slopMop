      "valid": "^[A-Za-z0-9_][A-Za-z0-9._$@-]{1,80}$",
      "reject": "(?i)^(?:true|false|null|none|nil|unknown|undefined|public|default|defaultuser0|all|everyone|n/?a|yes|no|on|off|enabled|disabled|nt|system|localsystem|networkservice|localservice|self|anonymous|nobody|authority|users?|usernames?|usr|login|accounts?|password|pass|passwd|domain|host|hostname|target|names?|id|string|value|example|your[\\w.-]*|my[_-]?user(?:name)?|some[_-]?user|[0-9][0-9._:-]*|[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}|s-1-[0-9-]+|[0-9a-f]{32,}|.*\\.(?:exe|dll|sys|ps1|psm1|psd1|bat|cmd|vbs|js|py|sh|rb|pl|php|aspx?|jsp|txt|log|json|xml|csv|tsv|zip|7z|rar|tar|gz|tgz|bz2|xz|dat|bin|tmp|bak|conf|cfg|ini|ya?ml|toml|pem|key|crt|cer|pfx|p12|kdbx|db|sqlite|html?|md|docx?|xlsx?|pptx?|pdf|lnk|iso|img|so|c|h|go|java|class|jar|war|msi|dmp|pcap|evtx|reg|pub))$",
      "patterns": [
        {"needs": [":/"], "pattern": "(?m)^(?P<value>[a-z_][a-z0-9_-]*):[^:\\n]*:\\d+:\\d+:[^:\\n]*:/[^:\\n]*:[^:\\s]*$"},
        {"needs": ["/home/"], "passing": true, "pattern": "/home/(?P<value>[A-Za-z0-9._-]{2,32})(?:/|$|\\s)"},
        {"needs": [":\\users\\"], "passing": true, "pattern": "(?i)[a-z]:\\\\Users\\\\(?P<value>[A-Za-z0-9._-]{2,32})(?:\\\\|$|\\s|\\\")"},
        {"needs": ["sudo ", "crontab ", "runuser", "mysql", "mariadb", "mongo", "psexec", "winrm", "crackmapexec", "cme ", "netexec", "nxc ", "smbmap", "winexe", "wmiexec", "smbexec", "atexec", "dcomexec", "impacket", "docker login", "az login", "rdesktop", "freerdp", "medusa", "enum4linux", "ldapdomaindump", "bloodhound", "certipy", "rubeus", "kerbrute", "redis-cli"], "pattern": "\\s-u\\s+(?P<value>\\\"[^\\\"]+\\\"|'[^']+'|[^\\s-]\\S*)"},
        {"needs": ["smbclient", "rpcclient", "smbget", "net rpc", "pth-", "sqlcmd", "psql"], "pattern": "\\s-U\\s+[\"']?(?P<value>[^\\s%\"']+)"},
        {"needs": ["hydra", "plink", "ssh ", "rlogin", "ncrack"], "pattern": "\\s-l\\s+(?P<value>\\\"[^\\\"]+\\\"|'[^']+'|[^\\s-]\\S*)"},
        {"needs": ["-username"], "pattern": "(?i)--?username(?:\\s+|=)(?P<value>\\\"[^\\\"]+\\\"|'[^']+'|[^\\s-]\\S*)"},
        {"needs": ["--user="], "pattern": "--user=[\"']?(?P<value>[^\\s:\"']+)"},
        {"needs": ["ssh", "scp", "sftp", "rsync"], "pattern": "\\b(?:ssh|scp|sftp|ssh-copy-id|sshpass|rsync)\\b.*?\\s(?P<value>[A-Za-z_][\\w.-]*)@[\\w.-]+"},
        {"needs": ["impacket", ".py ", "secretsdump", "psexec", "wmiexec", "smbexec", "atexec", "dcomexec", "getnpusers", "getuserspns", "gettgt", "getst", "lookupsid", "mssqlclient", "smbclient", "rpcclient", "ticketer", "addcomputer", "ntlmrelayx", "samrdump", "findelegation", "getadusers", "dpapi", "bloodyad", "certipy", "evil-winrm"], "unless": "@sha256:|://", "pattern": "(?:^|\\s)[\"']?[A-Za-z0-9.-]+/(?P<value>[A-Za-z0-9._$-]{2,64})(?::[^@\\s]*)?@[\\w.-]+"},
        {"needs": ["\\"], "unless": "(?i)\\bHK(?:LM|CU|CR|U|CC)\\\\|\\bHKEY_|\\\\(?:Windows|System32|Program)|-config\\b|\\bconfig:|\\bprintf\\b|\\becho\\s+-e\\b|\\\\[ntr](?:[\"'\\\\]|$)|\\\\\\\\|\\.(?:exe|dll|sys|ps1|psm1|psd1|bat|cmd|vbs|js|py|sh|rb|pl|php|aspx?|jsp|txt|log|json|xml|csv|tsv|zip|7z|rar|tar|gz|tgz|bz2|xz|dat|bin|tmp|bak|conf|cfg|ini|ya?ml|toml|pem|key|crt|cer|pfx|p12|kdbx|db|sqlite|html?|md|docx?|xlsx?|pptx?|pdf|lnk|iso|img|so|c|h|go|java|class|jar|war|msi|dmp|pcap|evtx|reg|pub)\\\\", "pattern": "(?:^|[\\s\\\"'=(\\[:,])(?:[A-Z][A-Z0-9-]{1,14}|[A-Za-z0-9-]+\\.[A-Za-z]{2,24})\\\\(?P<value>[A-Za-z0-9._$-]{2,32})(?:$|[\\s\\\"',;:)\\]])"},
        {"needs": ["\\"], "unless": "(?i)^\\s*HK", "pattern": "(?m)^\\s*(?P<value>[A-Za-z0-9][A-Za-z0-9.-]{0,62}\\\\[A-Za-z0-9._$-]{2,32})\\s*(?:$|\\s+S-1-5-)"},
        {"needs": ["uid="], "pattern": "\\buid=\\d+\\((?P<value>[^)\\s]+)\\)"},
        {"needs": ["pts/", "tty"], "pattern": "(?m)^(?P<value>[a-z_][a-z0-9_-]{0,31})\\s+(?:pts/\\d+|tty\\d+)\\s"},
