extends: default

ignore: |
  .cache/
  **/testdata/**

rules:
  document-start: disable
  line-length: disable
  truthy:
    check-keys: false
  indentation:
    spaces: 2
    indent-sequences: consistent
  comments:
    min-spaces-from-content: 1
  empty-lines:
    max: 2
  octal-values:
    forbid-implicit-octal: true
